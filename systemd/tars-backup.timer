[Unit]
Description=TARS hourly backup timer (runs tars-backup.service)
Documentation=https://github.com/iAMido/tars

[Timer]
# Hourly snapshots — restic dedup means each incremental is tiny.
# Worst-case data loss between a save and the next backup is now ≤1h
# instead of the previous ≤24h.
OnCalendar=hourly
# If the box was off when the trigger fired, run on next boot.
Persistent=true
# 5-min jitter so VPS clocks don't all hit B2 at exactly :00 every hour.
RandomizedDelaySec=5min
AccuracySec=1min

[Install]
WantedBy=timers.target
